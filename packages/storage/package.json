{
  "name": "@yourtutor/storage",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform Drizzle ORM + SQLite persistence layer with pluggable SqlDriver for Desktop & Android",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@yourtutor/core": "workspace:*",
    "drizzle-orm": "^0.41.0"
  }
}
