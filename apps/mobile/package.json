{
  "name": "@yourtutor/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Capacitor Android shell for YourTutor reusing @yourtutor/ui, @yourtutor/core, and @yourtutor/storage",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174",
    "build": "vite build",
    "cap:sync": "cap sync android",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^7.0.0",
    "@capacitor/android": "^7.2.0",
    "@capacitor/app": "^7.0.1",
    "@capacitor/camera": "^7.0.1",
    "@capacitor/core": "^7.2.0",
    "@yourtutor/core": "workspace:*",
    "@yourtutor/storage": "workspace:*",
    "@yourtutor/ui": "workspace:*",
    "katex": "^0.16.21",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.2.0",
    "@tailwindcss/vite": "^4.1.3",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.3",
    "vite": "^6.2.6"
  }
}
