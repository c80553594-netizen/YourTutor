{
  "name": "@yourtutor/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop shell, Companion Bridge HTTP/SSE server & web preview for YourTutor",
  "type": "module",
  "main": "./dist-electron/main/main.js",
  "scripts": {
    "dev:web": "vite --host 0.0.0.0 --port 5173",
    "dev:desktop": "pnpm build:electron && vite --port 5173",
    "build:electron": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "pnpm build:electron && pnpm build:renderer",
    "package:desktop": "pnpm build && electron-builder --config electron-builder.yml",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@yourtutor/core": "workspace:*",
    "@yourtutor/storage": "workspace:*",
    "@yourtutor/ui": "workspace:*",
    "katex": "^0.16.21",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.1.3",
    "vite": "^6.2.6"
  }
}
